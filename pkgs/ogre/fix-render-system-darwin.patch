diff --git a/RenderSystems/GL/CMakeLists.txt b/RenderSystems/GL/CMakeLists.txt
index d1afd2bc8..17360e5a3 100644
--- a/RenderSystems/GL/CMakeLists.txt
+++ b/RenderSystems/GL/CMakeLists.txt
@@ -59,6 +59,14 @@ if (WIN32)
 elseif (APPLE)
   file(GLOB PLATFORM_HEADERS "include/OSX/*.h" "src/OSX/*.h")
   file(GLOB PLATFORM_SOURCES "src/OSX/*.cpp" "src/OSX/*.mm")
+  
+  # Exclude Carbon/AGL files on ARM64 as they are not available
+  if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
+    list(REMOVE_ITEM PLATFORM_SOURCES 
+      "${CMAKE_CURRENT_SOURCE_DIR}/src/OSX/OgreOSXCarbonContext.cpp"
+      "${CMAKE_CURRENT_SOURCE_DIR}/src/OSX/OgreOSXCarbonWindow.cpp"
+      "${CMAKE_CURRENT_SOURCE_DIR}/src/OSX/OgreOSXRenderTexture.cpp")
+  endif()
 
   include_directories(src/OSX include/OSX "${OGRE_SOURCE_DIR}/OgreMain/include/OSX")
   set(PLATFORM_HEADER_INSTALL "OSX")
@@ -108,8 +116,14 @@ if (OGRE_CONFIG_THREADS)
 endif ()
 
 if (APPLE)
-    set_target_properties(RenderSystem_GL PROPERTIES
-        LINK_FLAGS "-framework Cocoa -framework Carbon -framework OpenGL")
+    if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
+        # Carbon framework is not available on ARM64
+        set_target_properties(RenderSystem_GL PROPERTIES
+            LINK_FLAGS "-framework Cocoa -framework OpenGL")
+    else()
+        set_target_properties(RenderSystem_GL PROPERTIES
+            LINK_FLAGS "-framework Cocoa -framework Carbon -framework OpenGL")
+    endif()
 endif ()
 
 ogre_config_framework(RenderSystem_GL)
