+++ b/OgreMain/CMakeLists.txt
@@ -43,6 +43,11 @@ list(REMOVE_ITEM SOURCE_FILES "${CMAKE_CURRENT_SOURCE_DIR}/src/OgreFreeImageCode
     "${CMAKE_CURRENT_SOURCE_DIR}/src/OgreSearchOps.cpp"
 )
 
+# Remove SSE-specific optimized utilities on non-x86 platforms
+if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "(x86)|(X86)|(amd64)|(AMD64)|(i.86)|(x86_64)|(X86_64)")
+    list(REMOVE_ITEM SOURCE_FILES "${CMAKE_CURRENT_SOURCE_DIR}/src/OgreOptimisedUtilSSE.cpp")
+endif()
+
 # Add platform specific files
 if (OGRE_BUILD_PLATFORM_NACL)
   include_directories("include/NaCl")
